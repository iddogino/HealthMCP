{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "healthmcp-api",
  "main": "src/index.ts",
  "account_id": "5f22bc2f89d05868489db974851f2bd1",
  "compatibility_date": "2026-09-07",
