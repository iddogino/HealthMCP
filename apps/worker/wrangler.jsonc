  "r2_buckets": [{"binding":"BLOBS","bucket_name":"healthmcp-encrypted"}],
  "kv_namespaces": [{"binding":"OAUTH_KV","id":"cb95c9974c6d4d5496efed51a3ca90a7"}],
  "vars": {"PUBLIC_ORIGIN":"https://mcp.healthmcp.cc","APP_TEAM_ID":"HL9SP7TJ3J","APP_BUNDLE_ID":"cc.healthmcp.app","APNS_TEAM_ID":"HL9SP7TJ3J","APNS_KEY_ID":"4P92YGPR7L","APNS_SANDBOX_KEY_ID":"H2F7LMNCSX"},
  "triggers": {"crons":["* * * * *"]},
