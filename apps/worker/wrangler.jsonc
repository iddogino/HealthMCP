{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "healthmcp-api",
  "main": "src/index.ts",
  "account_id": "5f22bc2f89d05868489db974851f2bd1",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{"pattern": "mcp.healthmcp.cc", "custom_domain": true}],
  "d1_databases": [{"binding":"DB","database_name":"healthmcp-db","database_id":"48f345cb-4704-4095-bc2e-42853ea91dd4","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"BLOBS","bucket_name":"healthmcp-encrypted"}],
  "kv_namespaces": [{"binding":"OAUTH_KV","id":"cb95c9974c6d4d5496efed51a3ca90a7"}],
  "analytics_engine_datasets": [{"binding":"EVENTS","dataset":"healthmcp_events"}],
  "ratelimits": [
    {"name":"DEVICE_USER_LIMITER","namespace_id":"680962501","simple":{"limit":1200,"period":60}},
    {"name":"DEVICE_GLOBAL_LIMITER","namespace_id":"680962502","simple":{"limit":12000,"period":60}},
    {"name":"UPLOAD_USER_LIMITER","namespace_id":"680962503","simple":{"limit":600,"period":60}},
    {"name":"UPLOAD_GLOBAL_LIMITER","namespace_id":"680962504","simple":{"limit":6000,"period":60}},
    {"name":"MCP_USER_LIMITER","namespace_id":"680962505","simple":{"limit":300,"period":60}},
    {"name":"MCP_GLOBAL_LIMITER","namespace_id":"680962506","simple":{"limit":3000,"period":60}},
    {"name":"DOWNLOAD_USER_LIMITER","namespace_id":"680962507","simple":{"limit":1200,"period":60}},
    {"name":"DOWNLOAD_GLOBAL_LIMITER","namespace_id":"680962508","simple":{"limit":12000,"period":60}}
  ],
  "vars": {"PUBLIC_ORIGIN":"https://mcp.healthmcp.cc","OAUTH_STORAGE_MODE":"d1","APP_TEAM_ID":"HL9SP7TJ3J","APP_BUNDLE_ID":"cc.healthmcp.app","APNS_TEAM_ID":"HL9SP7TJ3J","APNS_KEY_ID":"4P92YGPR7L","APNS_SANDBOX_KEY_ID":"H2F7LMNCSX"},
  "triggers": {"crons":["* * * * *"]},
  "observability": {"enabled":true,"head_sampling_rate":0.1},
  "limits": {"cpu_ms":30000}
}
