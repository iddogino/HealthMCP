<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Health MCP</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>UIRequiresFullScreen</key><true/>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSHealthUpdateUsageDescription</key><string>Health MCP connects to Apple Health to make an encrypted copy of the data you choose. It only requests read access and does not add, change, or delete Apple Health data.</string>
<key>NSHealthShareUsageDescription</key><string>Health MCP reads the health data you choose, encrypts it on this iPhone, and syncs it so agents you approve can work with it privately.</string>
<key>NSFaceIDUsageDescription</key><string>Confirm it is you before revealing your private decryption key.</string>
<key>UIBackgroundModes</key><array><string>processing</string><string>remote-notification</string><string>fetch</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>cc.healthmcp.app.sync</string></array>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>cc.healthmcp.pair</string><key>CFBundleURLSchemes</key><array><string>healthmcp</string></array></dict></array>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
</dict></plist>
